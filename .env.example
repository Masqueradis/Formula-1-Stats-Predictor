# Server
# --- Docker (лаба 8) ---
# Файл читается docker-compose как env_file (сервисы backend/backend-dev):
# секреты и строки подключения БД попадают в контейнеры отсюда,
# а контейнерные переопределения (имена сервисов postgres/mongo/mailhog,
# NODE_ENV, SMTP_PORT, CORS_ORIGINS) заданы в docker/docker-compose.yml.
PORT=3000
NODE_ENV=development

# Database
DATABASE_URL=postgres://f1user:f1pass@localhost:5432/f1stats

# MongoDB (прогнозы/комментарии, лаба 6)
MONGO_URI=mongodb://localhost:27017/f1stats

# Auth
JWT_SECRET=your-secret-key-here

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:5173

# Email (dev: Mailhog, SMTP :1025, UI :8025)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=noreply@f1stats.local

# Frontend (для ссылок в письмах)
FRONTEND_URL=http://localhost:5173

# Внешний API F1 (Jolpica-F1, потомок Ergast; ключ не нужен)
JOLPICA_BASE_URL=https://api.jolpi.ca/ergast/f1

# Автосинхронизация данных (cron)
SYNC_SEASON=2026
SYNC_CRON_ENABLED=false
SYNC_CRON_SCHEDULE=0 6 * * *

# Postgres (for docker-compose)
POSTGRES_USER=f1user
POSTGRES_PASSWORD=f1pass
POSTGRES_DB=f1stats
