# Server
PORT=3000
NODE_ENV=development

# Database
DATABASE_URL=postgres://f1user:f1pass@localhost:5432/f1stats

# Auth
JWT_SECRET=your-secret-key-here

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:5173

# Email (dev: Mailhog, SMTP :1025, UI :8025)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=noreply@f1stats.local

# Frontend (для ссылок в письмах)
FRONTEND_URL=http://localhost:5173

# Внешний API F1 (Jolpica-F1, потомок Ergast; ключ не нужен)
JOLPICA_BASE_URL=https://api.jolpi.ca/ergast/f1

# Автосинхронизация данных (cron)
SYNC_SEASON=2026
SYNC_CRON_ENABLED=false
SYNC_CRON_SCHEDULE=0 6 * * *

# Postgres (for docker-compose)
POSTGRES_USER=f1user
POSTGRES_PASSWORD=f1pass
POSTGRES_DB=f1stats
