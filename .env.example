# Simply lovely — пример переменных окружения
# Скопируйте в .env для локальной разработки: cp .env.example .env
# Секреты не коммитить. Для деплоя используйте панели провайдеров / GitHub Secrets / локальный .env.deploy (игнорируется как .env.*).

# --- Server ---
PORT=3000
NODE_ENV=development

# --- Database (локально) ---
DATABASE_URL=postgres://f1user:f1pass@localhost:5432/f1stats

# --- MongoDB (прогнозы/комментарии) ---
MONGO_URI=mongodb://localhost:27017/f1stats

# --- Redis (эпик-11): кэш, rate limit, Socket.IO adapter/presence ---
# REDIS_ENABLED=false или отсутствие REDIS_URL → in-memory fallback
REDIS_URL=redis://localhost:6379
REDIS_ENABLED=true

# --- Auth ---
JWT_SECRET=change-me-in-production

# --- CORS (через запятую) ---
CORS_ORIGINS=http://localhost:5173

# --- Email (dev: Mailhog, SMTP :1025, UI :8025) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=noreply@f1stats.local

# --- Frontend (ссылки в письмах, редиректы) ---
FRONTEND_URL=http://localhost:5173

# --- Внешний API F1 (Jolpica-F1, ключ не нужен) ---
JOLPICA_BASE_URL=https://api.jolpi.ca/ergast/f1

# --- Cron / фоновые задачи ---
SYNC_SEASON=2026
SYNC_CRON_ENABLED=false
SYNC_CRON_SCHEDULE=0 6 * * *
LEADERBOARD_CRON_ENABLED=true
LEADERBOARD_CRON_SCHEDULE=*/10 * * * *
EMAIL_REMINDER_CRON_ENABLED=true
EMAIL_REMINDER_CRON_SCHEDULE=0 * * * *

# --- Postgres (docker-compose) ---
POSTGRES_USER=f1user
POSTGRES_PASSWORD=f1pass
POSTGRES_DB=f1stats

# --- Деплой (production, значения задавать в панелях/Secrets, не здесь) ---
# Решения эпика-12: backend https://simply-lovely-api.onrender.com, frontend https://simply-lovely.netlify.app
# Redis не используется (fallback), UptimeRobot нет, письма не требуются (seed-учётки), бэкфилл 2000–2025 да, деплой по push
# NODE_ENV=production
# DATABASE_URL=postgres://...neon.tech/...?...sslmode=require
# MONGO_URI=mongodb+srv://...@....mongodb.net/...
# JWT_SECRET=<случайная строка >= 32 символов>
# CORS_ORIGINS=https://simply-lovely.netlify.app
# FRONTEND_URL=https://simply-lovely.netlify.app
# SMTP_HOST=
# SMTP_PORT=
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=
# REDIS_ENABLED=false
# SYNC_CRON_ENABLED=false
# SYNC_CRON_SCHEDULE=0 6 * * *
# LEADERBOARD_CRON_ENABLED=true
# EMAIL_REMINDER_CRON_ENABLED=true
