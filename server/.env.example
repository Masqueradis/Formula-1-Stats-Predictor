# Шаблон окружения бэкенда (server/.env).
# Скопировать в server/.env и заполнить локально; реальные значения не коммитить.
# Переменные POSTGRES_USER/POSTGRES_PASSWORD/POSTGRES_DB нужны только
# docker-compose — они описаны в корневом .env.example.

# Server
PORT=3000
NODE_ENV=development

# PostgreSQL (Sequelize). В production обязателен SSL:
# postgres://user:password@host:5432/db?sslmode=require
DATABASE_URL=postgres://f1user:f1pass@localhost:5432/f1stats

# MongoDB (народный прогноз, комментарии)
MONGO_URI=mongodb://localhost:27017/f1stats

# Redis: опционально. REDIS_ENABLED=false включает in-memory fallback.
REDIS_URL=redis://localhost:6379
REDIS_ENABLED=true

# Auth
JWT_SECRET=change-me-in-production

# CORS: через запятую, например http://localhost:5173,https://example.netlify.app
CORS_ORIGINS=http://localhost:5173

# Почта. В проде на Render Free SMTP-порты заблокированы:
# держите EMAIL_ENABLED=false; локально с MailHog — true и SMTP_PORT=1025.
EMAIL_ENABLED=false
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_REQUIRE_TLS=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=noreply@f1stats.local

# Ссылки в письмах (frontend)
FRONTEND_URL=http://localhost:5173

# Внешний API F1 (Jolpica-F1, ключ не нужен)
JOLPICA_BASE_URL=https://api.jolpi.ca/ergast/f1

# Автосинхронизация и фоновые задачи
SYNC_SEASON=2026
SYNC_CRON_ENABLED=false
SYNC_CRON_SCHEDULE=0 6 * * *
LEADERBOARD_CRON_ENABLED=true
LEADERBOARD_CRON_SCHEDULE=*/10 * * * *
EMAIL_REMINDER_CRON_ENABLED=true
EMAIL_REMINDER_CRON_SCHEDULE=0 * * * *

# Интеграционные тесты (только при запуске против реальных сервисов)
# INTEGRATION=1
# TEST_API_URL=http://localhost:3000
