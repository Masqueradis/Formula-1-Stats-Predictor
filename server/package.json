{
  "name": "f1-stats-server",
  "version": "1.0.0",
  "description": "F1 Stats & Predictor - backend server",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "db:create": "sequelize-cli db:create",
    "db:migrate": "sequelize-cli db:migrate",
    "db:migrate:undo": "sequelize-cli db:migrate:undo",
    "db:seed": "sequelize-cli db:seed:all",
    "db:seed:undo": "sequelize-cli db:seed:undo:all",
    "seed:mongo": "node src/scripts/seedMongo.js",
    "sync:f1": "node src/scripts/syncF1.js"
  },
  "keywords": [
    "f1",
    "express",
    "rest-api"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "fast-xml-parser": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.2",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.0.10",
    "pg": "^8.23.0",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.8",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "sequelize-cli": "^6.6.5"
  }
}
