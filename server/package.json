{
  "name": "f1-stats-server",
  "version": "1.0.0",
  "description": "F1 Stats & Predictor - backend server",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "db:create": "sequelize-cli db:create",
    "db:migrate": "sequelize-cli db:migrate",
    "db:migrate:undo": "sequelize-cli db:migrate:undo",
    "db:seed": "sequelize-cli db:seed:all",
    "db:seed:undo": "sequelize-cli db:seed:undo:all",
    "seed:mongo": "node src/scripts/seedMongo.js",
    "sync:f1": "node src/scripts/syncF1.js",
    "reconcile:vote-roster": "node src/scripts/reconcileVoteRoster.js",
    "test": "jest --runInBand",
    "test:coverage": "jest --runInBand --coverage",
    "test:integration": "jest --runInBand tests/integration",
    "test:mongo": "INTEGRATION=1 jest --runInBand tests/integration/mongo.integration.test.js",
    "sync:history": "node src/scripts/syncHistory.js"
  },
  "jest": {
    "coverageThreshold": {
      "**/src/services/probabilityService.js": {
        "statements": 60,
        "branches": 60,
        "functions": 60,
        "lines": 60
      },
      "**/src/services/leaderboardService.js": {
        "statements": 60,
        "branches": 60,
        "functions": 60,
        "lines": 60
      },
      "**/src/services/predictionService.js": {
        "statements": 60,
        "branches": 60,
        "functions": 60,
        "lines": 60
      },
      "**/src/cache/cacheService.js": {
        "statements": 60,
        "branches": 60,
        "functions": 60,
        "lines": 60
      }
    }
  },
  "keywords": [
    "f1",
    "express",
    "rest-api"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@socket.io/redis-adapter": "^8.3.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.2",
    "fast-xml-parser": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.2",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.0.10",
    "pg": "^8.23.0",
    "pg-hstore": "^2.3.4",
    "rate-limit-redis": "^4.3.1",
    "redis": "^4.7.1",
    "sequelize": "^6.37.8",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.14",
    "sequelize-cli": "^6.6.5",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.3.1"
  }
}
